{
  "name": "homeflow-backend",
  "version": "1.0.0",
  "description": "Backend API server for HomeFlow task management system",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate:up": "node-pg-migrate up -f migrate-config.js",
    "migrate:down": "node-pg-migrate down -f migrate-config.js",
    "migrate:create": "node-pg-migrate create -f migrate-config.js",
    "lint": "eslint src/ --fix"
  },
  "keywords": ["homeflow", "task-management", "api", "express"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "node-pg-migrate": "^6.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}